SECRET_KEY=change-me
DEBUG=True

# Simple JWT's own signing key, kept separate from SECRET_KEY. Rotating this
# value invalidates every outstanding access and refresh token without
# touching anything else derived from SECRET_KEY.
JWT_SIGNING_KEY=change-me-too
ALLOWED_HOSTS=localhost,127.0.0.1

# Hosts are Docker Compose service names, not localhost. Containers resolve
# each other by service name on the Compose network, and localhost inside the
# web container is the web container itself.
DATABASE_URL=postgres://postgres:postgres@db:5432/onboarding

# Redis database numbers are separated on purpose. The Celery broker gets 0,
# the Django cache gets 1, and the Celery result backend gets 2. Sharing one
# number would let a Celery queue purge drop cached dashboard payloads.
CELERY_BROKER_URL=redis://redis:6379/0
REDIS_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Consumed by the db service in docker-compose.yml to initialize the cluster.
# These must stay consistent with the credentials and database name inside
# DATABASE_URL above, since nothing cross-checks them for you.
POSTGRES_DB=onboarding
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# There is deliberately no HF_TOKEN here. all-MiniLM-L6-v2 is a public,
# ungated model, so sentence-transformers downloads it anonymously. Setting
# the variable is worse than leaving it out: huggingface_hub reads HF_TOKEN
# straight out of the environment whether or not this project asks it to, so a
# placeholder or an expired value gets sent as a bearer token on a request
# that would have succeeded unauthenticated. HF_HOME, set in the Dockerfile,
# is the variable that actually matters here, and it points the download cache
# at the hf-cache volume.